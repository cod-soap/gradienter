/* ============================================================
 * app.wxss - 全局样式
 * 工业风深色主题，定义CSS变量和通用组件样式
 * ============================================================ */

/* 引入主题变量 */
@import './styles/variables.wxss';
@import './styles/mixins.wxss';

/* 全局 page 背景色 */
page {
  background-color: var(--color-bg-primary);
  color: var(--color-text-primary);
  font-family: var(--font-sans);
  box-sizing: border-box;
}

/* ============================================================
 * 通用布局类
 * ============================================================ */

/* flex 居中容器 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* flex 列布局 */
.flex-col {
  display: flex;
  flex-direction: column;
}

/* flex 行布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

/* flex 两端对齐 */
.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

/* ============================================================
 * 通用卡片样式（工业风：深色背景+细微边框+左侧指示条）
 * ============================================================ */
.card {
  background-color: var(--color-bg-secondary);
  border: 1rpx solid var(--color-line-primary);
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-lg);
  position: relative;
  overflow: hidden;
}

/* 卡片左侧亮色指示条 */
.card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background-color: var(--color-accent-blue);
  border-radius: var(--radius-md) 0 0 var(--radius-md);
}

/* 激活态卡片（左侧指示条变绿） */
.card--active::before {
  background-color: var(--color-accent-green);
}

/* ============================================================
 * 通用按钮样式
 * ============================================================ */

/* 基础工业风按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: var(--radius-sm);
  font-size: var(--font-size-label);
  font-weight: 500;
  transition: all 150ms ease;
  /* 清除微信默认按钮样式 */
  border: none;
  background: none;
  line-height: 1;
}

/* 主要按钮（亮蓝色） */
.btn--primary {
  background-color: var(--color-accent-blue);
  color: var(--color-text-accent);
  border: 1rpx solid var(--color-accent-blue);
}

/* 次要按钮（轮廓样式） */
.btn--secondary {
  background-color: transparent;
  color: var(--color-accent-blue);
  border: 1rpx solid var(--color-accent-blue);
}

/* 警示按钮（红色） */
.btn--danger {
  background-color: transparent;
  color: var(--color-accent-red);
  border: 1rpx solid var(--color-accent-red);
}

/* 成功按钮（绿色） */
.btn--success {
  background-color: transparent;
  color: var(--color-accent-green);
  border: 1rpx solid var(--color-accent-green);
}

/* 按钮点击态：缩小+高亮（用于active伪类） */
.btn:active {
  transform: scale(0.95);
  opacity: 0.85;
}

/* 禁用态按钮 */
.btn--disabled,
.btn[disabled] {
  opacity: 0.4;
  pointer-events: none;
}

/* ============================================================
 * 角度数值显示（大号等宽字体）
 * ============================================================ */
.angle-value {
  font-family: var(--font-mono);
  font-size: var(--font-size-angle-lg);
  color: var(--color-text-accent);
  letter-spacing: 2rpx;
}

.angle-value--md {
  font-size: var(--font-size-angle-md);
}

.angle-value--sm {
  font-size: var(--font-size-angle-sm);
}

/* 角度标签（X: / Y:） */
.angle-label {
  font-size: var(--font-size-tip);
  color: var(--color-text-secondary);
  margin-right: 8rpx;
}

/* ============================================================
 * 分割线
 * ============================================================ */
.divider {
  height: 1rpx;
  background-color: var(--color-line-secondary);
  margin: var(--spacing-md) 0;
}

/* ============================================================
 * 空状态提示
 * ============================================================ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xxl) var(--spacing-lg);
  color: var(--color-text-secondary);
  font-size: var(--font-size-label);
  text-align: center;
}

/* ============================================================
 * Toast / 提示文字
 * ============================================================ */
.hint-text {
  font-size: var(--font-size-tip);
  color: var(--color-text-secondary);
  text-align: center;
}
