/* ============================================================
 * records.wxss - 我的记录页面样式
 * 工业风深色列表页，记录卡片滚动区域 + 空状态引导
 * ============================================================ */

@import "../../styles/variables.wxss";

/* 页面根容器：撑满全屏 */
.records-page {
  width: 100%;
  height: 100vh;
  background-color: var(--color-bg-primary);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ============================================================
   记录列表区域
   ============================================================ */

/* 滚动容器：占满屏幕高度 */
.records-list {
  flex: 1;
  height: 100%;
  box-sizing: border-box;
}

/* 列表头部：左右两列布局 */
.records-header {
  padding: var(--spacing-md) var(--spacing-lg);
  padding-top: var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-line-secondary);
  margin-bottom: var(--spacing-md);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.records-header__left {
  display: flex;
  flex-direction: column;
}

.records-header__count {
  display: block;
  font-size: var(--font-size-label);
  color: var(--color-text-accent);
  font-family: var(--font-mono);
  margin-bottom: 4rpx;
}

.records-header__hint {
  display: block;
  font-size: var(--font-size-tip);
  color: var(--color-text-secondary);
}

/* 清空按钮：右侧红色边框小按钮 */
.records-header__clear-btn {
  padding: 10rpx 20rpx;
  border: 1rpx solid var(--color-accent-red);
  border-radius: var(--radius-sm);
  background-color: rgba(255, 23, 68, 0.08);
}

.records-header__clear-btn--hover {
  opacity: 0.65;
  transform: scale(0.95);
}

.records-header__clear-text {
  font-size: var(--font-size-tip);
  color: var(--color-accent-red);
}

/* 卡片列表容器：左右留边距 */
.records-body {
  padding: 0 var(--spacing-lg);
}

/* 底部安全区：防止最后一张卡片被系统底部栏遮挡 */
.records-footer-safe {
  height: 80rpx;
}

/* ============================================================
   空状态区域
   ============================================================ */

/* 空状态容器：垂直居中 */
.records-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xxl);
}

/* 空状态图标区域 */
.records-empty__icon {
  margin-bottom: var(--spacing-xl);
}

/* 罗盘表盘装饰图案 */
.records-empty__dial {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-line-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-bg-secondary);
  box-shadow: 0 0 30rpx rgba(0, 230, 118, 0.1);
}

.records-empty__dial-inner {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-accent-green);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.4;
}

.records-empty__dial-text {
  font-size: 48rpx;
  color: var(--color-accent-green);
}

/* 空状态标题 */
.records-empty__title {
  font-size: var(--font-size-subtitle);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
}

/* 空状态描述文字 */
.records-empty__desc {
  font-size: var(--font-size-label);
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: var(--spacing-xl);
  line-height: 1.6;
}

/* 引导按钮 */
.records-empty__btn {
  padding: var(--spacing-sm) var(--spacing-xl);
  background-color: var(--color-bg-tertiary);
  border: 1rpx solid var(--color-accent-blue);
  border-radius: var(--radius-full);
  box-shadow: var(--glow-blue);
}

.records-empty__btn--hover {
  opacity: 0.7;
  transform: scale(0.97);
}

.records-empty__btn-text {
  font-size: var(--font-size-label);
  color: var(--color-text-accent);
}
