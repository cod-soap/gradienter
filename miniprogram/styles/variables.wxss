/* ============================================================
 * variables.wxss - 工业风主题变量
 * 定义完整的色彩体系、字体规范、间距规范
 * 所有页面和组件通过 CSS 变量引用这些值，方便全局统一修改
 * ============================================================ */

page {
  /* ----------------------------------------------------------
   * 背景色系 - 深色工业风三级背景
   * ---------------------------------------------------------- */
  --color-bg-primary: #1A1A2E;       /* 深藏青 - 主背景，页面底色 */
  --color-bg-secondary: #16213E;     /* 深靛蓝 - 卡片/面板背景 */
  --color-bg-tertiary: #0F3460;      /* 深蓝 - 高亮区域背景、激活态 */

  /* ----------------------------------------------------------
   * 强调色 - 高对比度工业指示色
   * ---------------------------------------------------------- */
  --color-accent-green: #00E676;     /* 霓虹绿 - 水平/正常状态指示 */
  --color-accent-red: #FF1744;       /* 警示红 - 倾斜过大/异常指示 */
  --color-accent-yellow: #FFD600;    /* 警示黄 - 接近水平/中间状态 */
  --color-accent-blue: #2979FF;      /* 亮蓝 - 按钮/交互元素 */
  --color-accent-orange: #FF6D00;    /* 警示橙 - 中等偏离状态 */

  /* ----------------------------------------------------------
   * 文字色
   * ---------------------------------------------------------- */
  --color-text-primary: #E0E0E0;     /* 浅灰 - 主文字 */
  --color-text-secondary: #9E9E9E;   /* 中灰 - 副文字、提示 */
  --color-text-accent: #FFFFFF;      /* 白色 - 强调数值 */
  --color-text-disabled: #616161;    /* 深灰 - 禁用态文字 */

  /* ----------------------------------------------------------
   * 刻度线/线条色
   * ---------------------------------------------------------- */
  --color-line-primary: #455A64;     /* 蓝灰 - 主刻度线、卡片边框 */
  --color-line-secondary: #37474F;   /* 深蓝灰 - 次刻度线、分割线 */
  --color-line-highlight: #00E676;   /* 霓虹绿 - 零点高亮刻度线 */

  /* ----------------------------------------------------------
   * 气泡/管体颜色（用于Canvas绘制，这里作为参考文档）
   * 注意：Canvas内无法直接使用CSS变量，需在TS中硬编码相同颜色值
   * ---------------------------------------------------------- */
  --color-bubble: rgba(0, 230, 118, 0.6);       /* 半透明绿 - 气泡填充 */
  --color-bubble-border: #00E676;                /* 霓虹绿 - 气泡边框 */
  --color-tube-bg: rgba(255, 255, 255, 0.08);   /* 微透明白 - 管体背景 */
  --color-tube-border: #455A64;                  /* 蓝灰 - 管体边框 */

  /* ----------------------------------------------------------
   * 字体族
   * ---------------------------------------------------------- */
  --font-mono: 'Menlo', 'Courier New', monospace; /* 等宽字体 - 角度数值 */
  --font-sans: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif; /* 无衬线 - 正文 */

  /* ----------------------------------------------------------
   * 角度数值字体大小
   * ---------------------------------------------------------- */
  --font-size-angle-lg: 48rpx;     /* 主角度数值（万向水平仪大显示） */
  --font-size-angle-md: 36rpx;     /* 次要角度数值 */
  --font-size-angle-sm: 28rpx;     /* 辅助数值（工具栏内） */

  /* ----------------------------------------------------------
   * 标签/正文字体大小
   * ---------------------------------------------------------- */
  --font-size-title: 36rpx;        /* 页面标题 */
  --font-size-subtitle: 30rpx;     /* 子标题 / 卡片标题 */
  --font-size-label: 28rpx;        /* 功能标签、按钮文字 */
  --font-size-tip: 24rpx;          /* 提示文字 */
  --font-size-tiny: 20rpx;         /* 极小文字（版本号等） */

  /* ----------------------------------------------------------
   * 间距系统（基础单位 8rpx）
   * ---------------------------------------------------------- */
  --spacing-xs: 8rpx;              /* 极小间距 */
  --spacing-sm: 16rpx;             /* 小间距 */
  --spacing-md: 24rpx;             /* 中等间距 */
  --spacing-lg: 32rpx;             /* 大间距 */
  --spacing-xl: 48rpx;             /* 超大间距 */
  --spacing-xxl: 64rpx;            /* 极大间距 */

  /* ----------------------------------------------------------
   * 圆角系统
   * ---------------------------------------------------------- */
  --radius-sm: 8rpx;               /* 按钮、小组件 */
  --radius-md: 16rpx;              /* 卡片 */
  --radius-lg: 24rpx;              /* 大卡片、底部弹出层 */
  --radius-full: 9999rpx;          /* 完整圆形/胶囊 */

  /* ----------------------------------------------------------
   * 阴影/发光效果（工业风霓虹发光）
   * ---------------------------------------------------------- */
  --shadow-card: 0 4rpx 24rpx rgba(0, 0, 0, 0.4);  /* 卡片阴影 */
  --glow-green: 0 0 20rpx rgba(0, 230, 118, 0.3);   /* 绿色霓虹发光 */
  --glow-blue: 0 0 20rpx rgba(41, 121, 255, 0.3);   /* 蓝色霓虹发光 */

  /* ----------------------------------------------------------
   * 工具栏高度（底部固定工具栏）
   * ---------------------------------------------------------- */
  --toolbar-height: 120rpx;
  --navbar-height: 88rpx;
}
