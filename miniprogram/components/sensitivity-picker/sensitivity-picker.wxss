/* sensitivity-picker.wxss - 灵敏度选择器样式 */
@import '../../styles/variables.wxss';

:host {
  display: inline-flex;
  align-items: center;
}

/* ---- 触控区域（圆点 + 标签） ---- */
.picker {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--color-line-secondary);
  background-color: rgba(255, 255, 255, 0.04);
}

.picker__label {
  font-size: var(--font-size-tip);
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.picker__dots {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
}

.picker__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-line-primary);
  border: 1rpx solid var(--color-line-secondary);
  transition: all 150ms ease;
}

.picker__dot--active {
  background-color: var(--color-accent-blue);
  border-color: var(--color-accent-blue);
  box-shadow: 0 0 4rpx rgba(41, 121, 255, 0.5);
}

.picker__arrow {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-left: 2rpx;
}

/* ---- 弹出面板遮罩层 ---- */
.panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ---- 弹出面板容器 ---- */
.panel {
  width: 580rpx;
  background-color: var(--color-bg-secondary);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--color-line-primary);
  overflow: hidden;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.5);
}

.panel__title {
  font-size: var(--font-size-label);
  color: var(--color-text-accent);
  text-align: center;
  padding: 28rpx 0 20rpx;
  border-bottom: 1rpx solid var(--color-line-secondary);
  letter-spacing: 2rpx;
}

/* ---- 单个选项行 ---- */
.panel__option {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
  transition: background-color 150ms;
}

.panel__option:last-child {
  border-bottom: none;
}

.panel__option--active {
  background-color: rgba(41, 121, 255, 0.1);
}

/* 单选圆圈 */
.panel__radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--color-line-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.panel__radio--checked {
  border-color: var(--color-accent-blue);
}

.panel__radio-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-accent-blue);
}

/* 名称和描述 */
.panel__text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.panel__name {
  font-size: var(--font-size-label);
  color: var(--color-text-primary);
  font-weight: 500;
}

.panel__desc {
  font-size: var(--font-size-tip);
  color: var(--color-text-secondary);
}

/* 右侧迷你圆点（档位可视化） */
.panel__dots-mini {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
  margin-left: 16rpx;
}

.panel__dot-mini {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-full);
  background-color: var(--color-line-secondary);
}

.panel__dot-mini--on {
  background-color: var(--color-accent-blue);
}
